            "args": {
              "order_id": "ORDER-42"
            }
          }
        ],
        "valid_paths": [
          [
            "order_intake",
            "dispatch",
            "shipment",
            "receipt"
          ]
        ],
        "runtime_reference": "tool_output.shipment_tracking.state"
      }
    },
    {
      "id": "order-return",
