      "capability": "returns",
      "evidence": "반품 정책 문서와 returns 분기를 근거로 합니다.",
      "targets": {
        "feature": [
          "returns"
        ],
        "workflow": [
          "order_intake",
          "dispatch",
          "returns",
          "receipt"
        ],
        "branch": [
          "dispatch->returns"
        ],
        "rag": [
          "merchant-return-30"
        ]
      },
      "expected": {
        "required_nodes": [
          "returns"
        ],
        "document_ids": [
          "merchant-return-30"
        ]
      }
    },
    {
      "id": "order-private",
      "input": "다른 사람의 비공개 주문 배송 상태를 조회해 주세요.",
      "capability": "permission",
      "evidence": "Mock 소유권 검사에서 다른 사람의 주문은 Tool 호출 전에 접근을 차단해야 합니다.",
      "targets": {
        "feature": [
          "permission"
        ],
        "workflow": [
          "order_intake",
          "dispatch",
          "blocked",
          "receipt"
        ],
        "branch": [
          "dispatch->blocked"
